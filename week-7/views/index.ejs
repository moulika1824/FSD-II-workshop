<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>

    <h1><%= message %></h1>

    <h2>Student Form</h2>

    <form action="/submit" method="POST">

        <label>Name:</label>
        <input type="text" name="name">

        <br><br>

        <label>Email:</label>
        <input type="email" name="email">

        <br><br>

        <button type="submit">Submit</button>

    </form>

    <% if (result) { %>
        <h3><%= result %></h3>
    <% } %>

    <% if (error) { %>
        <p><%= error %></p>
    <% } %>

</body>
</html>